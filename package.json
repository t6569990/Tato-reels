{
  "name": "tato-reels-creator-android",
  "version": "1.0.0",
  "private": true,
  "description": "Build Android package for Tato Reels Creator using Capacitor",
  "scripts": {
    "build:android": "node scripts/prepare-android.mjs && esbuild scripts/admob-entry.js --bundle --format=esm --platform=browser --outfile=dist/assets/admob.bundle.js",
    "apply:android-icon": "node scripts/apply-android-icon.mjs",
    "configure:admob": "node scripts/configure-admob-android.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "esbuild": "^0.25.12",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "@capacitor-community/admob": "7.2.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  }
}
